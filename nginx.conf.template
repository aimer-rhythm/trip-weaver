# Nginx 反代配置（替代 Caddy）
# 模板变量 ${SITE_DOMAIN} 由 envsubst 在容器启动时替换（nginx:alpine 官方机制）
#
# HTTPS：把证书放到 certs volume（fullchain.pem / privkey.pem）后，
# 取消下方 ssl server 块的注释并重载：docker compose exec nginx nginx -s reload
# 申请证书（宿主机或另起容器跑 certbot）：
#   docker run --rm -p 80:80 -v trip-weaver_nginx_certs:/etc/letsencrypt \
#     certbot/certbot certonly --standalone -d <域名>
#   然后将 /etc/letsencrypt/live/<域名>/{fullchain,privkey}.pem 复制为
#   certs volume 根的 fullchain.pem / privkey.pem

server {
    listen 80;
    server_name ${SITE_DOMAIN};

    location / {
        proxy_pass http://app:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE：关闭缓冲与压缩，进度事件实时到达浏览器
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 1h;
    }
}

