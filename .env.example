# ===== 织程 TripWeaver 环境变量 =====
# 复制为 .env 后按需修改；标注 [必填] 的缺失时服务拒绝启动

# 服务端口（Windows 本地开发若遇 EACCES，多为端口被系统保留，可改用 8787 等）
PORT=3001

# PostgreSQL 连接串（09-18 起为唯一运行态数据库；本地开发可指向本机 PG 或 Neon/Supabase）
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/tripweaver
# Compose 内 postgres 服务密码（仅 docker compose 部署使用）
POSTGRES_PASSWORD=

# 旧 SQLite 数据文件路径（仅一次性迁移脚本 scripts/migrate-sqlite-to-pg.ts 读取）
DATABASE_PATH=./data/tripweaver.db

# [必填] Key 加密主钥：32 字节 hex（64 个字符）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# 注册模式：open（开放注册，默认）/ invite（凭邀请码）/ closed（关闭注册）
# 未设置时自动推断：INVITE_CODE 非空 → invite，否则 open（老部署升级后行为不变）
REGISTRATION_MODE=

# 注册邀请码（仅 invite 模式使用；该模式下必填）
INVITE_CODE=

# GitHub 登录（可选）：到 GitHub Developer settings 注册 OAuth App 后填写；留空 = 不显示 GitHub 登录
# callback 填 <APP_BASE_URL>/api/auth/github/callback；本地开发需另注册一个 App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 站点对外地址（启用 GitHub 登录时必填），例：https://trip.example.com；本地开发：http://localhost:5173
APP_BASE_URL=

# 预构建镜像（可选）：docker compose 默认拉取 ghcr.io/aimer-rhythm/trip-weaver:latest
# 本地构建兜底：TRIPWEAVER_IMAGE='' docker compose up --build -d
TRIPWEAVER_IMAGE=

# 站点供 Key（普通用户默认使用；留空 = 纯 BYOK 模式）
SITE_LLM_BASE_URL=https://api.deepseek.com/v1
SITE_LLM_API_KEY=
SITE_LLM_MODEL=deepseek-chat

# ===== RAG 向量召回（可选；留空即不生成向量，检索退化为纯关键词召回）=====
# 未填时回落到上面的 SITE_LLM_*（OpenAI 兼容端点普遍同址提供 /embeddings）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 默认 cf/bge-m3
EMBEDDING_MODEL=
# 必须为 1024，与 canonical_places / research_evidence 的 vector(1024) 列对齐；
# 改维度需 DROP COLUMN 重建并重跑 apps/server/scripts/embed-backfill.ts
EMBEDDING_DIMS=1024

# 每用户每日生成次数上限
GEN_DAILY_LIMIT=3

# 每用户每日对话轮数上限（问答式入口；与生成配额相互独立，对话轮次不计入 GEN_DAILY_LIMIT）
CHAT_DAILY_LIMIT=40

# ===== 调研数据源（均可选；都不填 = 纯模型知识调研，生成不受影响）=====

# 站点默认高德开放平台 Web 服务 Key（用户可在设置页保存个人 Key，并优先用于自己的任务）
# 用户未配置或显式清除个人 Key 时回退此值；两者都为空时自动降级。
# 调研候选的结构化底座：地点/评分/人均/营业时间/图片
# 申请：https://console.amap.com/dev/key/app 创建应用 → Key 类型选「Web服务」
# 个人实名认证后基础搜索约 5000 次/月；仅作调研候选来源，行程坐标走高德 GCJ-02 主链（Nominatim 仅兜底）
AMAP_KEY=
# 全站高德调用日额度（超出自动降级，不阻断生成）
# 注意：单次生成需预留 GEOCODE_MAX_PER_TASK(40) + ROUTE_MAX_PER_TASK(20) = 60 次，
# 剩余额度低于 60 时该任务整条地理链路跳过高德、回落到 Nominatim（慢且可能不可达）。
# 一次 3 天行程实测约 68 次，150 只够 2 次生成，600 约合 8~9 次。
AMAP_DAILY_BUDGET=600

# ===== 前端地图渲染（可选；未配置时自动降级）=====
# 高德 JS API 需要**独立类型**的 Key：在高德控制台创建时平台选「Web端(JS API)」，
# 与上面的 Web 服务（AMAP_KEY）**不通用**。创建时还要填**域名白名单**（本地开发填 localhost），
# 并把配套的**安全密钥**填到下一项（JS API 2.0 起强制，缺失会让所有请求被拒）。
# 两个值都会下发到浏览器 —— 这是 JS API 的设计，不可隐藏，靠域名白名单限权。
# 留空 = 不启用高德渲染，前端静默使用 Leaflet + 高德栅格瓦片（无 POI 文字隐藏）。
# AMAP_JS_KEY=
# AMAP_JS_SECURITY_CODE=

# ===== 地图服务商（两家**互补**，两个 Key 都要配）=====
# 没有 MAP_PROVIDER 开关：每条能力按「配了哪个 Key」自动决策。
#   · 地点搜索（search_pois）  → **固定天地图**：高德 v5/place/text 与地理编码主路径共用同一份
#                               个人配额，实测会被打满，两者互相挤占
#   · 路线规划 + 地理编码       → **高德优先**，缺 AMAP_KEY 时降级天地图；两者都缺则坐标走 Nominatim、
#                               通勤走启发式
# 天地图搜索不可用（未配 TIANDITU_KEY / 未开通地名搜索权限 / 请求失败）→ 空结果 + 模型知识，
# **不回落高德**（否则会把刚腾给地理编码的配额重新挤掉）。

# 站点天地图 **服务端** Key（接口参数名 tk）。控制台申请时类型选「服务端」：
# 三个适配器（geocoder / drive·walk·bus / v2 search）都是服务端直连 api.tianditu.gov.cn，
# 前端不碰天地图，故**不需要也不要申请**「浏览器端」（那个绑 Referer 白名单，用于 JS API 与瓦片底图）。
# 另：地名搜索 V2 需在控制台用同一个 Key 单独配权限，否则 /v2/search 返回非 1000 状态。
# 天地图用 CGCS2000（≈WGS-84），适配层负责与库内 GCJ-02 互转，上层与前端不需要感知坐标系差异。
# 申请：https://console.tianditu.gov.cn/api/key
# 与高德的能力差异：地名搜索需在控制台**单独申请权限**；POI 无评分/人均/营业时间/图片；
# **无骑行路径规划**（骑行段回落启发式）；驾车/步行/公交返回 XML，公交无总时长需累加各段。
# 前端底图仍是 Leaflet + 高德瓦片（与库内 GCJ-02 自洽）—— 切天地图只影响服务端数据源。
TIANDITU_KEY=
# 全站天地图调用日额度（与高德**分别计数**，互不影响）
# 与高德同理：单次生成需预留 GEOCODE_MAX_PER_TASK(40) + ROUTE_MAX_PER_TASK(30) = 70 次。
TIANDITU_DAILY_BUDGET=600

# 站点默认 Web 搜索 API Key（攻略语义层：玩法/避雷/是否需要预约）
# 用户可在设置页保存个人 Key + Base URL，个人配置优先；清除后回退这里，两者都为空时降级。
# 默认 LangSearch：https://langsearch.com/ 免费申请
SEARCH_API_KEY=
# 站点搜索端点（可选，默认 https://api.langsearch.com）；个人新配置的空 URL 也使用此默认值
# 博查（https://open.bochaai.com ，¥0.036/次）同族接口：改此 URL + 换 Key 即可切换，零代码改动
SEARCH_API_BASE_URL=
# 全站搜索调用日额度（超出自动降级，不阻断生成）
SEARCH_DAILY_BUDGET=500

# BYOK baseUrl 的 SSRF 私网豁免清单（逗号分隔的 host，例如站长自己的 Ollama）
# 例：SSRF_ALLOWLIST=localhost:11434,192.168.1.100:11434
SSRF_ALLOWLIST=
