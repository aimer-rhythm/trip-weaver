# ===== 织程 TripWeaver 环境变量 =====
# 复制为 .env 后按需修改；标注 [必填] 的缺失时服务拒绝启动

# 服务端口（Windows 本地开发若遇 EACCES，多为端口被系统保留，可改用 8787 等）
PORT=3001

# SQLite 数据文件路径（相对 apps/server 运行目录）
DATABASE_PATH=./data/tripweaver.db

# [必填] Key 加密主钥：32 字节 hex（64 个字符）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# 注册模式：open（开放注册，默认）/ invite（凭邀请码）/ closed（关闭注册）
# 未设置时自动推断：INVITE_CODE 非空 → invite，否则 open（老部署升级后行为不变）
REGISTRATION_MODE=

# 注册邀请码（仅 invite 模式使用；该模式下必填）
INVITE_CODE=

# GitHub 登录（可选）：到 GitHub Developer settings 注册 OAuth App 后填写；留空 = 不显示 GitHub 登录
# callback 填 <APP_BASE_URL>/api/auth/github/callback；本地开发需另注册一个 App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 站点对外地址（启用 GitHub 登录时必填），例：https://trip.example.com；本地开发：http://localhost:5173
APP_BASE_URL=

# 站点供 Key（普通用户默认使用；留空 = 纯 BYOK 模式）
SITE_LLM_BASE_URL=https://api.deepseek.com/v1
SITE_LLM_API_KEY=
SITE_LLM_MODEL=deepseek-chat

# 每用户每日生成次数上限
GEN_DAILY_LIMIT=3

# ===== 调研数据源（均可选；都不填 = 纯模型知识调研，生成不受影响）=====

# 高德开放平台 Web 服务 Key（调研候选的结构化底座：地点/评分/人均/营业时间/图片）
# 申请：https://console.amap.com/dev/key/app 创建应用 → Key 类型选「Web服务」
# 个人实名认证后基础搜索约 5000 次/月；仅作调研候选来源，行程坐标仍走 OSM Nominatim
AMAP_KEY=
# 全站高德调用日额度（超出自动降级，不阻断生成）
AMAP_DAILY_BUDGET=150

# Web 搜索 API Key（攻略语义层：玩法/避雷/是否需要预约）
# 默认 LangSearch：https://langsearch.com/ 免费申请
SEARCH_API_KEY=
# 搜索端点（可选，默认 https://api.langsearch.com）
# 博查（https://open.bochaai.com ，¥0.036/次）同族接口：改此 URL + 换 Key 即可切换，零代码改动
SEARCH_API_BASE_URL=
# 全站搜索调用日额度（超出自动降级，不阻断生成）
SEARCH_DAILY_BUDGET=500

# BYOK baseUrl 的 SSRF 私网豁免清单（逗号分隔的 host，例如站长自己的 Ollama）
# 例：SSRF_ALLOWLIST=localhost:11434,192.168.1.100:11434
SSRF_ALLOWLIST=
