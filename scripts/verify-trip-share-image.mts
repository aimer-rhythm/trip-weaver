// Disposable PostgreSQL database; upstream Images API is always mocked.
import assert from 'node:assert/strict';
import fs from 'node:fs/promises';
import path from 'node:path';
import Fastify from 'fastify';
import cookie from '@fastify/cookie';
import { Client } from 'pg';
import { eq } from 'drizzle-orm';
import { makeSampleTrip } from '@tripweaver/shared';

const name = `share_image_verify_${Date.now()}`;
const databaseBase = process.env.SHARE_IMAGE_TEST_DATABASE_URL ?? 'postgres://postgres@127.0.0.1:18797/postgres';
const admin = new Client({ connectionString: databaseBase });
await admin.connect();
await admin.query(`CREATE DATABASE "${name}"`);
const databaseUrl = new URL(databaseBase); databaseUrl.pathname = `/${name}`;
process.env.DATABASE_URL = databaseUrl.toString();
process.env.MASTER_KEY = 'a'.repeat(64);
process.env.IMAGE_API_BASE_URL = 'https://8.8.8.8/v1';
process.env.IMAGE_API_KEY = 'image-test-fixture';
process.env.IMAGE_MODEL = 'gpt-image2.5';
process.env.AMAP_KEY = '';
process.env.TIANDITU_KEY = '';
process.env.REGISTRATION_MODE = 'open';
process.env.GITHUB_CLIENT_ID = '';
process.env.GITHUB_CLIENT_SECRET = '';
const { db, pool } = await import('../apps/server/src/db/client');
const { trips, users } = await import('../apps/server/src/db/schema');
const { createSession } = await import('../apps/server/src/auth/session');
const { createTrip } = await import('../apps/server/src/services/tripService');
const { tripRoutes } = await import('../apps/server/src/routes/trips');
const { notificationRoutes } = await import('../apps/server/src/routes/notifications');
const { getGenerationResult } = await import('../apps/server/src/services/notificationService');
const { runMigrations } = await import('../apps/server/src/db/migrate');
const { env } = await import('../apps/server/src/env');
const { installApiResponses } = await import('../apps/server/src/http/apiResponse');
const app = Fastify();
installApiResponses(app);
const originalFetch = globalThis.fetch;
let calls = 0;
let posterFile: string | null = null;
globalThis.fetch = async (url, init) => {
  calls++;
  assert.equal(String(url), 'https://8.8.8.8/v1/images/generations');
  assert.equal(JSON.parse(String(init?.body)).model, 'gpt-image2.5');
  return Response.json({ data: [{ b64_json: 'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+a7hQAAAAASUVORK5CYII=' }] });
};
try {
  // 旧表补列与重复启动都应安全；此时仅操作本脚本创建的隔离数据库。
  await pool.query('ALTER TABLE generation_notifications DROP COLUMN share_image_style');
  await runMigrations(pool);
  await runMigrations(pool);
  await db.insert(users).values(['owner', 'other'].map(id => ({ id, email: `${id}@share.test`, passwordHash: '', createdAt: new Date() })));
  const owner = `tw_session=${(await createSession('owner')).token}`;
  const other = `tw_session=${(await createSession('other')).token}`;
  const trip = await createTrip('owner', makeSampleTrip());
  await app.register(cookie);
  await app.register(tripRoutes, { prefix: '/api/trips' });
  await app.register(notificationRoutes, { prefix: '/api/notifications' });
  const notifications = (cookieValue: string) => app.inject({ method: 'GET', url: '/api/notifications', headers: { cookie: cookieValue } });
  const request = (cookieValue?: string, payload: unknown = { trip }, id = trip.id) => app.inject({ method: 'POST', url: `/api/trips/${id}/share-image`, headers: cookieValue ? { cookie: cookieValue } : {}, payload });
  const read = (cookieValue?: string, style?: string, id = trip.id) => app.inject({ method: 'GET', url: `/api/trips/${id}/share-image${style ? `?style=${style}` : ''}`, headers: cookieValue ? { cookie: cookieValue } : {} });
  assert.equal((await request()).statusCode, 401);
  assert.equal((await read()).statusCode, 401);
  assert.equal((await request(other)).statusCode, 404);
  assert.equal((await read(other)).statusCode, 404);
  assert.equal((await request(owner, { trip }, 'missing')).statusCode, 404);
  assert.equal((await read(owner, undefined, 'missing')).statusCode, 404);
  assert.equal((await request(owner, { trip: { ...trip, id: 'wrong' } })).statusCode, 400);
  assert.equal((await request(owner, { trip: { ...trip, title: '' } })).statusCode, 400);
  assert.equal((await read(owner)).statusCode, 404, 'no stored poster before the first generation');
  assert.equal(calls, 0);
  const response = await request(owner);
  assert.equal(response.statusCode, 200, response.body);
  const stored = response.json().data;
  assert.equal(stored.mimeType, 'image/png');
  assert.equal(stored.notification.shareImageStyle, 'journal');
  assert.equal(stored.notification.tripId, trip.id);
  const firstNote = stored.notification;
  assert.equal((await notifications(owner)).json().data.items.length, 1);
  assert.equal((await notifications(owner)).json().data.hasUnread, true);
  assert.equal((await notifications(other)).json().data.items.length, 0, '通知按账号隔离');
  assert.equal(await getGenerationResult('owner', firstNote.jobId), null, '海报通知不能冒充行程生成结果');
  assert.equal((await app.inject({ method: 'POST', url: `/api/notifications/${firstNote.id}/read`, headers: { cookie: other } })).statusCode, 404);
  assert.match(stored.url, /^\/media\/share-posters\/[a-f0-9]{64}\.png$/);
  assert.equal(response.body.includes('image-test-fixture'), false);
  assert.equal(response.headers['cache-control'], 'no-store');
  posterFile = path.resolve('data/media', stored.url.replace('/media/', ''));
  assert.ok((await fs.stat(posterFile)).size > 0, 'poster bytes are persisted on disk');
  assert.equal((await request(owner)).statusCode, 200);
  assert.equal(calls, 1, 'stored poster avoids a paid request');
  const restored = await read(owner);
  assert.equal(restored.statusCode, 200, restored.body);
  assert.equal(restored.json().data.url, stored.url, 'GET returns the stored poster a reload would show');
  assert.equal(calls, 1, 'restoring never calls the model');
  assert.equal(restored.json().data.notification, undefined, 'GET 不携带需要再次交付的通知');
  assert.equal((await notifications(owner)).json().data.items.length, 1, '缓存 POST 与 GET 不新增通知');
  assert.equal((await read(owner, 'ink')).statusCode, 404, 'style is part of the lookup');
  assert.equal((await request(owner, { trip, regenerate: true })).statusCode, 200);
  assert.equal(calls, 2, 'explicit regeneration bypasses the stored poster through the HTTP schema and route');
  assert.equal((await read(owner)).statusCode, 200, 'regeneration leaves a restorable poster');
  const secondPage = (await notifications(owner)).json().data;
  assert.equal(secondPage.items.length, 2, '重新生成新增一条通知');
  assert.notEqual(secondPage.items[0].id, firstNote.id);
  await app.inject({ method: 'POST', url: '/api/notifications/read-all', headers: { cookie: owner }, payload: { through: firstNote.sequence } });
  const afterRead = (await notifications(owner)).json().data;
  assert.equal(afterRead.hasUnread, true, '全部已读保留游标之后的新通知');
  assert.equal(afterRead.items[0].readAt, null);
  assert.notEqual(afterRead.items[1].readAt, null);
  assert.equal((await request(owner, { trip, regenerate: 'invalid' })).statusCode, 400);
  // 行程内容改变后提示词变化：旧成品不再回显，避免展示与当前行程不符的海报
  await db.update(trips).set({ data: { ...trip, title: '重新规划的行程' } }).where(eq(trips.id, trip.id));
  assert.equal((await read(owner)).statusCode, 404, 'changed itinerary never replays the old poster');
  await db.update(trips).set({ data: trip }).where(eq(trips.id, trip.id));
  const providers = [...env.imageProviders];
  env.imageProviders.length = 0;   // 模拟「未配置任何中转站」
  const missingKey = await request(owner, { trip: { ...trip, title: 'new draft' } });
  assert.equal(missingKey.statusCode, 503);
  assert.equal(calls, 2);
  assert.equal((await notifications(owner)).json().data.items.length, 2, '失败生成不发布成功通知');
  env.imageProviders.push(...providers);
  await pool.query(`CREATE FUNCTION reject_share_notification() RETURNS trigger LANGUAGE plpgsql AS $$ BEGIN RAISE EXCEPTION 'fixture notification failure'; END $$`);
  await pool.query(`CREATE TRIGGER reject_share_notification BEFORE INSERT ON generation_notifications FOR EACH ROW EXECUTE FUNCTION reject_share_notification()`);
  const notificationFailure = await request(owner, { trip, regenerate: true });
  assert.equal(notificationFailure.statusCode, 200, '通知写入故障不丢弃已经成功的海报');
  assert.equal(notificationFailure.json().data.notification, undefined);
  assert.equal((await read(owner)).statusCode, 200);
  assert.equal((await notifications(owner)).json().data.items.length, 2);
  console.log('PASS share image API: 401/404/400, stored poster on GET, changed-itinerary invalidation, missing-key 503; no live provider calls');
} finally {
  globalThis.fetch = originalFetch;
  await app.close();
  await pool.end();
  if (posterFile) await fs.unlink(posterFile).catch(() => {});
  if (!/^share_image_verify_\d+$/.test(name)) throw new Error('Invalid disposable DB name');
  await admin.query(`DROP DATABASE "${name}"`);
  await admin.end();
}
