+"""景点介绍搜索：来源筛选、正文归属、缓存、失败与取消，不访问外网。"""
+from __future__ import annotations
+import asyncio
+import pytest
+from app.extract import place_research as research
+
+
+@pytest.mark.parametrize('url', ['http://127.0.0.1/a', 'http://localhost/a', 'file:///a',
+    'http://[::1]/a', 'https://user:password@example.com', 'https://example.com:22/a', 'https://x.local/a'])
+def test_拒绝本机和非网页URL(url):
+    assert not research.public_url(url)
+
+
+def test_政府优先_不使用小红书来源_不误认相似域名():
+    result = research.candidate_urls({'sources': [{'url': u} for u in [
+        'https://www.xiaohongshu.com/a', 'https://example.com/a',
+        'https://www.beijing.gov.cn/a', 'https://www.beijing.gov.cn/a']]})
+    assert result == ['https://www.beijing.gov.cn/a', 'https://example.com/a']
+    assert research.source_rank('https://beijing.gov.cn.evil.com/a') == 1
+
+
+def test_抓到正文且匹配主体才可当资料():
+    raw = {'content': '这是北京南锣鼓巷的历史与街巷介绍。' * 20}
+    assert research.fetched_source(raw, 'https://www.beijing.gov.cn/a', '北京', '南锣鼓巷', 0)['authority'] == 'official'
+    assert research.fetched_source(raw, 'https://example.com/a', '北京', '地坛公园', 0) is None
+    assert research.fetched_source({'content': ''}, 'https://example.com/a', '北京', '南锣鼓巷', 0) is None
+
+
+def test_搜索摘要不能充当原文_缓存避免重复请求(monkeypatch, tmp_path):
+    calls = []
+    async def cli(args, timeout=100):
+        calls.append(args)
+        if args[0] == 'search':
+            return {'ok': True, 'content': '这是未核实的搜索综合答案', 'sources': [
+                {'url': 'https://www.beijing.gov.cn/a'}]}
+        return {'ok': True, 'content': '南锣鼓巷保存着传统胡同和院落的空间布局，具有鲜明的老北京街巷特色。' * 4}
+    monkeypatch.setattr(research, 'run_cli', cli)
+    first = asyncio.run(research.research_place('北京', '南锣鼓巷', cache_dir=tmp_path))
+    second = asyncio.run(research.research_place('北京', '南锣鼓巷', cache_dir=tmp_path))
+    assert not first['cacheHit'] and second['cacheHit'] and len(calls) == 2
+    assert '未核实' not in second['sources'][0]['text']
+    assert '--model' in calls[0]
+
+
+def test_抓取失败继续下一来源_不缓存空资料(monkeypatch, tmp_path):
+    async def cli(args, timeout=100):
+        if args[0] == 'search':
+            return {'sources': [{'url': 'https://example.com/a'}]}
+        raise RuntimeError('fetch failed')
+    monkeypatch.setattr(research, 'run_cli', cli)
+    result = asyncio.run(research.research_place('北京', '南锣鼓巷', cache_dir=tmp_path))
+    assert result['sources'] == [] and len(result['warnings']) == 1
+    assert not list(tmp_path.glob('*.json'))
+
+
+def test_搜索取消向上传播(monkeypatch, tmp_path):
+    async def cancelled(*args, **kwargs):
+        raise asyncio.CancelledError()
+    monkeypatch.setattr(research, 'run_cli', cancelled)
+    with pytest.raises(asyncio.CancelledError):
+        asyncio.run(research.research_place('北京', '南锣鼓巷', cache_dir=tmp_path))
