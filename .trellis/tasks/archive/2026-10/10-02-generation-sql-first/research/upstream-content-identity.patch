+/** 展示机器提纯结果与逐句出处；保留取消/失败前已完成部分。 */
+function object(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+const labels: Record<string, string> = {
+  saved: '已保存', preview: '预览', skipped: '已跳过',
+  insufficient: '网页资料不足', search_failed: '搜索失败', rejected: '未通过校验', conflict: '数据已变化',
+}
+
+export default function PlaceContentResult({ value }: { value: unknown }) {
+  if (!object(value) || !Array.isArray(value.items)) return null
+  const items = value.items.filter(object)
+  return (
+    <section aria-label="完整介绍提纯结果" className="max-h-[26vh] shrink-0 overflow-y-auto border-b px-4 py-3 text-sm">
+      <p className="font-medium">
+        {value.preview ? '仅预览' : '补充结果'} · 已处理 {String(value.processed ?? 0)}/{String(value.selected ?? 0)}
+        {' · '}生成 {String(value.generated ?? 0)} · 保存 {String(value.saved ?? 0)}
+        {' · '}资料不足 {String(value.insufficient ?? 0)} · 未通过 {String(value.rejected ?? 0)}
+        {' · '}跳过 {String(value.skipped ?? 0)} · 冲突 {String(value.conflicts ?? 0)}
+        {' · '}搜索失败 {String(value.search_failed ?? 0)}
+      </p>
+      <p className="mt-1 text-xs text-muted-foreground">
+        搜索网页提供事实，模型知识补充稳定背景；小红书另用于体验与避坑。保存后需执行导出导入，行程库才会更新。
+        {Number(value.remaining) > 0 ? ` 本次上限之外还有 ${String(value.remaining)} 个待处理景点。` : ''}
+      </p>
+      {value.status === 'running' ? <p className="mt-1 text-xs">{String(value.current_place ?? '')} · {String(value.phase ?? '')}</p> : null}
+      {items.map((item, index) => (
+        <details key={`${String(item.name)}-${index}`} className="mt-2 rounded border px-3 py-2" open={items.length === 1}>
+          <summary className="cursor-pointer">
+            {String(item.name)} · {labels[String(item.status)] ?? String(item.status)}
+            {typeof item.intro === 'string' ? ` · ${item.intro.length} 字` : ''}
+          </summary>
+          <p className="mt-1 text-xs text-muted-foreground">{String(item.reason ?? '')}</p>
+          {typeof item.intro === 'string' ? <p className="mt-2 leading-relaxed">{item.intro}</p> : null}
+          {Array.isArray(item.highlights) ? item.highlights.filter(object).flatMap(source =>
+            Array.isArray(source.citations) && source.citations.length
+              ? source.citations.filter(object) : [source],
+          ).map((source, i) => (
+            <blockquote key={i} className="mt-2 border-l-2 pl-3 text-xs leading-relaxed text-muted-foreground">
+              {source.basis === 'model_knowledge' ? <>模型知识补充（无网页引文）：{String(source.text ?? '')}</> : String(source.quote ?? '')}{' '}
+              {typeof source.sourceUrl === 'string' && /^https?:\/\//i.test(source.sourceUrl) ? (
+                <a href={source.sourceUrl} target="_blank" rel="noopener noreferrer" className="underline">原始出处</a>
+              ) : null}
+            </blockquote>
+          )) : null}
+        </details>
+      ))}
+      {!items.length && Number(value.selected) === 0 ? <p className="mt-2">当前范围内没有待补齐的有效主景点。</p> : null}
+    </section>
+  )
+}
