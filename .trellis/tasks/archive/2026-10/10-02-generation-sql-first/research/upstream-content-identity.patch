+"""完整介绍资料获取：搜索发现→抓正文→按主景点归属核对；不以小红书拼百科。"""
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import time
+from urllib.parse import urlsplit
+
+from app.clean.alias import aliases_for
+
+DEFAULT_SEARCH_MODEL = 'grok-4.7'
+CACHE_SECONDS = 7 * 86400
+MAX_PAGES = 3
+
+
+def cli_command() -> list[str]:
+    executable = shutil.which('smart-search')
+    if not executable:
+        raise RuntimeError('未找到 smart-search，请安装并配置搜索与网页抓取服务')
+    path = Path(executable)
+    if os.name == 'nt' and path.suffix.lower() in ('.cmd', '.ps1'):
+        # npm包装器改为直接Node入口，景点名/URL不经过shell解释。
+        entry = path.parent / 'node_modules/@konbakuyomu/smart-search/npm/bin/smart-search.js'
+        node = shutil.which('node')
+        if not node or not entry.is_file():
+            raise RuntimeError('smart-search Node入口不可用，请重新安装CLI')
+        return [node, str(entry)]
+    return [str(path)]
+
+
+async def run_cli(arguments: list[str], timeout: int = 100) -> dict:
+    process = await asyncio.create_subprocess_exec(*cli_command(), *arguments,
+        stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.PIPE)
+    try:
+        stdout, _ = await asyncio.wait_for(process.communicate(), timeout)
+    except BaseException:
+        if process.returncode is None:
+            if os.name == 'nt':
+                killer = await asyncio.create_subprocess_exec('taskkill', '/PID', str(process.pid), '/T', '/F',
+                    stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL)
+                await killer.wait()
+            else:
+                process.kill()
+            await process.wait()
+        raise
+    try:
+        result = json.loads(stdout.decode('utf-8-sig'))
+    except (ValueError, UnicodeError) as exc:
+        raise RuntimeError('搜索服务未返回有效JSON，请检查 smart-search 配置') from exc
+    if process.returncode or not isinstance(result, dict) or result.get('ok') is not True:
+        # 不回传供应商原始报错，避免把请求头或密钥写入作业日志。
+        raise RuntimeError('搜索或抓取失败，请检查 smart-search 的模型、网络与服务配置')
+    return result
+
+
+def public_url(url: object) -> bool:
+    if not isinstance(url, str):
+        return False
+    try:
+        parsed = urlsplit(url)
+        host = (parsed.hostname or '').lower()
+        return (parsed.scheme in ('https', 'http') and bool(host) and '.' in host
+                and not parsed.username and not parsed.password and parsed.port in (None, 80, 443)
+                and host not in ('localhost',) and not host.endswith(('.local', '.internal'))
+                and not re.fullmatch(r'[\d.]+', host) and ':' not in host)
+    except ValueError:
+        return False
+
+
+def source_rank(url: str) -> int:
+    host = (urlsplit(url).hostname or '').lower()
+    if host.endswith('.gov.cn'):
+        return 3
+    if host == 'visitbeijing.com.cn' or host.endswith('.visitbeijing.com.cn'):
+        return 2
+    return 1
+
+
+def candidate_urls(result: dict) -> list[str]:
+    candidates = []
+    for key in ('primary_sources', 'extra_sources', 'sources'):
+        for item in result.get(key, []) if isinstance(result.get(key), list) else []:
+            url = item.get('url') if isinstance(item, dict) else None
+            if public_url(url):
+                host = (urlsplit(url).hostname or '').lower()
+                if any(host == domain or host.endswith('.' + domain) for domain in
+                       ('xiaohongshu.com', 'xhslink.com', 'douyin.com', 'weibo.com', 'zhihu.com')):
+                    continue
+                if url not in candidates:
+                    candidates.append(url)
+    return sorted(candidates, key=source_rank, reverse=True)
+
+
+def fetched_source(result: dict, url: str, city: str, name: str, index: int) -> dict | None:
+    content = result.get('content')
+    if not isinstance(content, str) or len(content.strip()) < 80:
+        return None
+    names = [name, *aliases_for(city, name)]
+    # 至少有主体名，完整页面仍由后续审稿核对每句归属。
+    if city not in content or not any(n and n in content for n in names):
+        return None
+    return {'id': f'web-{index}', 'text': content[:30000], 'url': url,
+            'observedAt': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
+            'authority': 'official' if source_rank(url) >= 2 else 'reference', 'basis': 'web'}
+
+
+async def research_place(city: str, name: str, *, model=DEFAULT_SEARCH_MODEL,
+                         cache_dir: Path | None = None) -> dict:
+    cache_dir = cache_dir or Path('reports/place-content/research')
+    key = hashlib.sha256(f'web-v1:{city}:{name}:{model}'.encode()).hexdigest()
+    path = cache_dir / f'{key}.json'
+    if path.exists():
+        try:
+            cached = json.loads(path.read_text(encoding='utf-8'))
+            if (cached.get('city') == city and cached.get('name') == name
+                    and time.time() - cached.get('savedAt', 0) < CACHE_SECONDS and cached.get('sources')):
+                return {**cached, 'cacheHit': True}
+        except (ValueError, TypeError):
+            pass  # 损坏/旧版缓存重新获取，不写入模型候选资料。
+    query = (f'{city} {name} 景点完整介绍：地理定位、历史背景、核心建筑与景观看点。'
+             '优先景区官网、政府文旅或博物馆专题介绍，返回该地点详情网页URL，'
+             '不要城市景点列表、营销攻略、小红书或预约票务页面。')
+    discovery = await run_cli(['search', query, '--model', model, '--extra-sources', '3',
+                               '--timeout', '60', '--format', 'json'])
+    urls = candidate_urls(discovery)
+    sources, warnings = [], []
+    for url in urls[:5]:
+        try:
+            fetched = await run_cli(['fetch', url, '--format', 'json'], timeout=60)
+            source = fetched_source(fetched, url, city, name, len(sources))
+            if source:
+                sources.append(source)
+            else:
+                warnings.append({'url': url, 'reason': '正文不足或未匹配该地点'})
+        except (RuntimeError, TimeoutError):
+            warnings.append({'url': url, 'reason': '网页抓取失败'})
+        if len(sources) == MAX_PAGES:
+            break
+    result = {'city': city, 'name': name, 'sources': sources, 'cacheHit': False,
+              'searchedUrls': urls, 'warnings': warnings, 'savedAt': time.time()}
+    if sources:
+        cache_dir.mkdir(parents=True, exist_ok=True)
+        temporary = path.with_suffix('.tmp')
+        temporary.write_text(json.dumps(result, ensure_ascii=False, indent=2), encoding='utf-8')
+        temporary.replace(path)
+    return result
