+"""提纯内容契约：稳定介绍与动态政策分层，保留引文/来源；行程端无需删句。"""
+from __future__ import annotations
+
+import re
+
+CONTENT_VERSION = 1
+_DYNAMIC = re.compile(r'预约|门票|票价|联票|套票|免费|收费|开放|营业|闭馆|闭园|关闭|停业|排队|限流|放票|抢票|\d+(?:\.\d+)?\s*元|\d{1,2}[:：]\d{2}')
+_NEGATIVE = re.compile(r'无需(?:提前)?预约|无须(?:提前)?预约|不(?:需要|用)(?:提前)?预约|免预约')
+_POSITIVE = re.compile(r'(?:需|须|要|请|必须|提前|实名|公众号|小程序|官网).{0,16}预约|预约(?:购票|入园|参观|登记)')
+_UNCERTAIN = re.compile(r'可能|或许|疑似|不确定|待确认|建议.*预约')
+_HYPE = re.compile(r'有求必应|必灵|最灵|国家级审美|封神|天花板|必打卡|必去|必看|放心冲|闭眼冲|绝绝子|人间仙境|超嗨|最美|最强|最热闹|人极挤|体验感翻倍|圣地')
+_SITUATIONAL = re.compile(r'酒店|民宿|安检口|快速到前排|不用排|人少|正值|目前|现在|今天|近日|亮灯|占据好位置|避开人潮|→|>>|Day\s*\d|\d+\s*(?:分钟|小时|点|天后)|(?:步行|走路).{0,8}(?:即可|就到|直达|可达)')
+
+
+def intro_rejection(text: str) -> str | None:
+    """离线内容闸门；不是事实验证器，来源仍需逐句核对。政策交给独立字段。"""
+    if _DYNAMIC.search(text):
+        return 'dynamic_policy'
+    if _HYPE.search(text):
+        return 'promotional_claim'
+    if _SITUATIONAL.search(text):
+        return 'situational_claim'
+    return None
+
+
+def reservation_policy(texts: list[str]) -> dict:
+    """缺少/含混/相互冲突的证据不生成确定政策；无需预约不能因非空变required。"""
+    notes = list(dict.fromkeys(t.strip() for t in texts if isinstance(t, str) and t.strip()))
+    states = set()
+    for note in notes:
+        if _UNCERTAIN.search(note):
+            continue
+        negative = bool(_NEGATIVE.search(note))
+        positive = bool(_POSITIVE.search(_NEGATIVE.sub('', note)))
+        if negative:
+            states.add('none')
+        if positive:
+            states.add('required')
+    conflict = len(states) > 1
+    status = next(iter(states)) if len(states) == 1 else 'unknown'
+    note = ('预约资料存在冲突，请通过官方渠道确认。' if conflict else
+            '；'.join(notes) if status != 'unknown' else '预约要求尚未核实，请以官方最新信息为准。')
+    return {'reservation': status, 'reservationNote': note[:120], 'reservationEvidence': notes,
+            'reservationConflict': conflict}
+
+
+def validate_extracted_content(raw: object, source: str) -> dict | None:
+    """仅接收有原文逐字引文的结构化看点；不截断引文、不把动态句改成静态事实。"""
+    if not isinstance(raw, dict):
+        return None
+    items = []
+    for item in raw.get('highlights', []) if isinstance(raw.get('highlights'), list) else []:
+        if not isinstance(item, dict):
+            continue
+        text, quote = item.get('text'), item.get('quote')
+        if not isinstance(text, str) or not isinstance(quote, str):
+            continue
+        text, quote = text.strip(), quote.strip()
+        if not text or not quote or len(text) > 100 or len(quote) > 200 or quote not in source:
+            continue
+        if intro_rejection(text) or intro_rejection(quote):
+            continue
+        # 不允许删除「可能/据说」限定后再给出确定文案。
+        if any(word in quote and word not in text for word in ('可能', '据说', '或许', '相传')):
+            continue
+        items.append({'text': text, 'quote': quote})
+    return {'version': CONTENT_VERSION, 'highlights': items[:4]} if items else None
+
+
+def build_place_content(items: list[dict], observed_at: str) -> dict:
+    """新提纯结构优先；存量仅复用有来源的稳定理由分句，原始证据另行完整导出。"""
+    result: list[dict] = []
+    seen: set[str] = set()
+    for item in items:
+        text = str(item.get('text') or '').strip()
+        source_url = str(item.get('sourceUrl') or '')
+        if not text or not source_url.startswith(('http://', 'https://')) or intro_rejection(text):
+            continue
+        if len(text) > 100 or text in seen:
+            continue
+        seen.add(text)
+        result.append({'text': text, 'quote': str(item.get('quote') or text), 'sourceUrl': source_url,
+                       'strength': 'weak', 'observedAt': str(item.get('observedAt') or observed_at)})
+        if len(result) == 4:
+            break
+    intro = ''
+    for item in result:
+        sentence = item['text'].rstrip('。') + '。'
+        if len(intro) + len(sentence) <= 200:
+            intro += sentence
+    return {'version': CONTENT_VERSION, 'intro': intro, 'highlights': result, 'compiledAt': observed_at}
+
+
+def legacy_highlights(text: str, source_url: str) -> list[dict]:
+    """旧资料不再花模型调用重写；取完整稳定分句作为有来源的社区看点。"""
+    return [{'text': part.strip(), 'quote': text, 'sourceUrl': source_url}
+            for part in re.split(r'[。！？；\n]', text or '')
+            if len(part.strip()) >= 6 and not intro_rejection(part)]
