   "evidence": [
    {
     "kind": "xhs_reason",
     "content": "泉眼众多，小鱼嬉戏，需赶早避开人流",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "泉水喷涌壮观，园内有历史建筑和纪念碑，值得一看",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "早上7点开放，建议9点前到，可避开人流拍到好照片，大学生凭畅游卡免门票",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "天下第一泉，三股水昼夜喷涌，园中有李清照纪念堂",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "门票40元，学生免费，游玩2小时",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "早上7点开放，建议9点前到可避开拥挤，拍照角度好，大学生凭畅游卡免门票",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "核心看三股水喷涌，园内有李清照纪念堂、万竹园，早上9点前人少",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "清晨泉水透亮，锦鲤水草清晰可见，濯缨池如绿野仙踪，值得一游",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "济南必玩景区，唯一需要门票的景点",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "建议九点前到达人较少，北门进东门出。",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "看三股泉水喷涌，泉池幽深波光粼粼，氛围感强",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "南门进北门出，人少好进，但越晚人越多，建议早去先看趵突泉",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "招牌景点，濯缨池静谧，池鱼可爱",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "南门进北门出，出后对面即五龙潭",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "景区较大，除趵突泉外还有多个泉、纪念馆、故居，门票40元",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "尽量九点前到达，人较少。",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "济南标志性景点，全园游玩路线清晰。",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "天下第一泉，三股水常年喷涌，园林雅致，有李清照纪念堂",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "语文书里的“天下第一泉”，园内泉群密布，一步一景，兼具自然与人文",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "北门进沿路有漂亮小潭，趵突泉石碑处人多但其余三边可坐",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "清晨6:30可早入园，东门南门离主泉近，人少体验好",
     "sourceUrl": ""
    }
   ]
