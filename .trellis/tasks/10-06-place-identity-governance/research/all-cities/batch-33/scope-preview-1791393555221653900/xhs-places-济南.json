   "evidence": [
    {
     "kind": "xhs_reason",
     "content": "免费，环境宁静，适合散步拍照，有龙潭观鱼和中共山东省委旧址",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "26处古泉藏身园中，秦琼祠所在地，潭水湛蓝如玉",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "免费，建议东门进南门出，游玩1.5小时",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "泉群密集，池水碧绿，可喂锦鲤、打卡秦琼祠，浅滩可碰泉水",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "泉水清澈见底，锦鲤成群，有龙潭观鱼胜景，夏天可踩水玩",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "免费且无需预约，有很多大锦鲤",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "建议西门进南门出，顺路游览。",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "七点开园，园子不小，一个小时能逛完，西门进南门出，斜对过就是趵突泉。",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "北方少有的清泉园林，泉水潺潺，景致清幽",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "景点不大但很美，各景点距离近",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "免费开放，泉水清澈，因今年雨水多泉眼喷水",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "从趵突泉北门步行五分钟过马路即到，南门进东门出，顺路",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "清晨人少安静，潭水清澈，适合静心放松",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "免费开放，西门进南门出，对面即趵突泉北门，交通便利",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "利用假山框架式构图，可拍绿地中心古今同框",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "园内泉潭相连，石桥古亭、绿树成荫，自然与人文兼具，安静治愈",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "园子不小，有内容可仔细逛，西门进南门出，七点开园。",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "南门进有文创店，五龙潭离门口近，还有秦琼祠",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "公园不大，很快能逛完，有很多小鸭子，可爱",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "人少清幽，泉水潺潺，适合慢悠悠散步",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "与趵突泉北门正对，路线顺路，可看五龙壁、主潭、名仕阁等",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "路线顺路，步行可达",
     "sourceUrl": ""
    },
    {
     "kind": "xhs_reason",
     "content": "西门进南门出，顺路游览。",
